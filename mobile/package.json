{
  "name": "gymflow-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "GymFlow Mobile — member-facing fitness companion app (offline-first).",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "e2e:build": "detox build -c android.emu.debug",
    "e2e:test": "detox test -c android.emu.debug",
    "sync:assets": "node scripts/syncWorkoutAssets.js",
    "postinstall": "node scripts/syncWorkoutAssets.js"
  },
  "dependencies": {
